                  {
                      "parameters":  {
                                         "jsCode":  "// Extract run_id and retry_count from the failed execution context.\n// Implements exponential backoff: 1min → 5min → 30min → 1h (then give up).\n\nconst execData = $input.first().json;\nconst workflowData = execData.execution?.workflowData ?? {};\nconst lastNode = execData.execution?.lastNodeExecuted ?? \u0027unknown\u0027;\n\n// Try to find run_id from any node output in the failed execution\nconst nodeData = execData.execution?.data?.resultData?.runData ?? {};\nlet runId = null;\nlet sourceKey = null;\n\n// Walk node outputs looking for run_id (set by POST /ingestion/start)\nfor (const [nodeName, nodeRuns] of Object.entries(nodeData)) {\n  for (const run of nodeRuns) {\n    const output = run?.data?.main?.[0]?.[0]?.json;\n    if (output?.run_id) { runId = output.run_id; }\n    if (output?.source_key) { sourceKey = output.source_key; }\n  }\n}\n\n// Determine retry count from error message pattern if available\nlet retryCount = 0;\nconst errorMsg = execData.execution?.error?.message ?? \u0027\u0027;\nconst retryMatch = errorMsg.match(/retry_count[\":]+\\s*(\\d+)/);\nif (retryMatch) retryCount = parseInt(retryMatch[1]);\n\n// Backoff schedule: attempt 0→1min, 1→5min, 2→30min, 3→1h, 4+→abandon\nconst backoffMs = [60000, 300000, 1800000, 3600000];\nconst waitMs = backoffMs[Math.min(retryCount, backoffMs.length - 1)];\nconst shouldRetry = retryCount \u003c 4;\n\nreturn [{\n  json: {\n    run_id: runId,\n    source_key: sourceKey,\n    retry_count: retryCount,\n    should_retry: shouldRetry,\n    wait_ms: waitMs,\n    wait_seconds: Math.floor(waitMs / 1000),\n    error_message: execData.execution?.error?.message ?? \u0027Unknown error\u0027,\n    failed_node: lastNode,\n    workflow_id: workflowData.id,\n    workflow_name: workflowData.name\n  }\n}];"
                                     },
