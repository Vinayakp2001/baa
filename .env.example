# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=baa
POSTGRES_USER=baa
POSTGRES_PASSWORD=changeme

# Full async DSN used by SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://baa:changeme@postgres:5432/baa

# ── Corporations Canada API ───────────────────────────────────────────────────
# Obtain from: https://www.ic.gc.ca/app/scr/cc/CorporationsCanada/fdrlCrpSrch.html
CORPS_CANADA_API_KEY=your_api_key_here

# ── Entity Resolution ─────────────────────────────────────────────────────────
# RapidFuzz token_sort_ratio threshold (0–100). Default: 88
FUZZY_MATCH_THRESHOLD=88

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost/n8n/

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL the browser uses to reach the API (via nginx reverse proxy)
NEXT_PUBLIC_API_URL=http://localhost/api

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Optional: website enrichment crawl ────────────────────────────────────────
# User-agent string for robots.txt compliance checks (req 15.9)
CRAWL_USER_AGENT=baa-pipeline/0.1 (+https://example.com/baa)

# ── Optional: BC OrgBook ─────────────────────────────────────────────────────
BC_ORGBOOK_BASE_URL=https://orgbook.gov.bc.ca/api/v4
